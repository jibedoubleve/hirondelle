<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0"/>
        <PackageReference Include="Shouldly" Version="4.3.0"/>
        <PackageReference Include="xunit.v3.core" Version="4.0.3"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Hirondelle\Hirondelle.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="**\*.sql"
                          Exclude="Migrations\Mixed\**"
                          LogicalName="Hirondelle\%(RecursiveDir)%(Filename)%(Extension)"/>
        <!-- Embeds every file (.sql, .SQL, .txt) regardless of the OS glob case sensitivity -->
        <EmbeddedResource Include="Migrations\Mixed\**"
                          LogicalName="Hirondelle\Migrations\Mixed\%(RecursiveDir)%(Filename)%(Extension)"/>
    </ItemGroup>
</Project>
